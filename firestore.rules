rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // User Profiles Collection
    match /users/{userId} {
      allow read, write: if isValidId(userId);
    }

    // Business Managers Collection
    match /business_managers/{bmId} {
      allow read, write: if isValidId(bmId);
    }

    // Ad Accounts Collection
    match /ad_accounts/{accountId} {
      allow read, write: if isValidId(accountId);
    }

    // Alerts Collection
    match /alerts/{alertId} {
      allow read, write: if isValidId(alertId);
    }
  }
}
